{
    "//": "LOCAL CO-DEV OVERLAY — copy to composer.local.json (gitignored) to edit the sibling packages live from the canonical root instead of cloning them from git. Then run `composer update \"schemastud/*\"` to symlink them. To restore the shippable git-resolved lock: delete composer.local.json and run `composer update \"schemastud/*\"` again. NEVER commit composer.local.json or a path-polluted composer.lock. Packages live under packages/<vendor>/, hence the ../../<vendor>/ paths.",
    "repositories": {
        "schemastud/laravel-data-schemas": {
            "type": "path",
            "url": "../../schemastud/laravel-data-schemas",
            "options": { "symlink": true }
        }
    }
}
